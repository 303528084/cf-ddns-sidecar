# DDNS 密钥示例（对应容器内 /app/data/ddns.env）
#
# 说明：这些内容都可以在后台界面「域名解析（DDNS）」卡片里直接填，
# 不需要手工编辑文件。这个文件只作参考——想知道界面背后到底写了什么，
# 或者想用文本编辑器直接改，就照这个格式。
#
# 只保留你选用的那一家服务商的密钥，其它留空或删除均可。
# 变量名是固定的，不要改。进程环境变量优先级高于本文件。

# ---- Cloudflare ----
# 在 dash.cloudflare.com → API Tokens 创建，权限需包含 DNS 编辑（Zone:DNS:Edit）
CF_API_TOKEN=
# 域名的 Zone ID（在 Cloudflare 域名概览页右侧）
CF_ZONE_ID=

# ---- 阿里云 ----
# 控制台 → 访问控制 RAM → 创建 AccessKey，授予 DNS 编辑权限
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 可选：多级公共后缀（如 example.com.cn）时显式指定根域名
# ALIYUN_ROOT_DOMAIN=

# ---- 腾讯云 DNSPod ----
# 控制台 → 访问管理 → API 密钥管理 → 新建密钥
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 可选：多级公共后缀时显式指定根域名
# DNSPOD_ROOT_DOMAIN=

# ---- 华为云 ----
# 控制台 → 我的凭证 → 访问密钥 → 新增
HUAWEI_AK=
HUAWEI_SK=
# 华为云的公网 zone ID（云解析服务域名列表里）
HUAWEI_ZONE_ID=
