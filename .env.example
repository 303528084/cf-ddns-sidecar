# 只保留你选用的那一家服务商的密钥，其它留空或删除均可。
# 环境变量名是固定的，不要改。

# ---- Cloudflare ----
# 在 dash.cloudflare.com → API Tokens 创建，权限需包含 DNS 编辑（Zone:DNS:Edit）
CF_API_TOKEN=
# 域名的 Zone ID（在 Cloudflare 域名概览页右下角）
CF_ZONE_ID=

# ---- 阿里云 ----
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---- 腾讯云 DNSPod ----
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---- 华为云 ----
HUAWEI_AK=
HUAWEI_SK=
# 华为云的公网 zone ID
HUAWEI_ZONE_ID=
