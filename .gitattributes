# 统一换行符策略：仓库内一律 LF，避免 CI 与飞牛 NAS 上脚本执行失败
* text=auto
*.go text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
/fpk/template/cmd/main text eol=lf
/fpk/template/manifest text eol=lf
/fpk/template/config/privilege text eol=lf
/fpk/template/config/resource text eol=lf
/fpk/template/app/ui/config text eol=lf
/fpk/template/wizard/config text eol=lf

# 飞牛生命周期脚本：必须 LF、必须可执行
fpk/template/cmd/* text eol=lf
