# DDNS 旁路容器配置
# 复制为 config.yaml 后按需修改。密钥不要写在这里，放到 .env 文件。

# 服务商类型：cloudflare / aliyun / dnspod / huawei 四选一
provider: cloudflare

# 目标域名（要把最优 IP 写进去的自有域名），例如 cf.example.com
domain: cf.example.com

# 轮询最优 IP 的间隔（秒），默认 30
poll_interval_seconds: 30

# 主体 config.json 在容器内的路径（本地 compose 已挂载，一般不用改）
subject_config_path: /app/subject/config.json

# 本容器状态文件路径（记录上次推送的 IP，避免重复写）
state_path: /app/data/state.json

# 健康检查监听地址
listen: ":8080"
