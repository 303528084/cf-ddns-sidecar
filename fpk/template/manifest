appname=cf-ddns-sidecar
version={{VERSION}}
display_name=优选 IP · DDNS
desc=自动测速选取最快 Cloudflare 边缘 IP，写入 AdGuard Home DNS 重写并同步到自有域名 DDNS，生成优选域名。
platform=x86
source=thirdparty
maintainer=Stone
distributor=Stone
desktop_uidir=ui
desktop_applaunchname=cf-ddns-sidecar.Application
ctl_stop=true
service_port=8080
checkport=false
os_min_version=1.2.0
changelog=这一版改了两处：测速设置里两栏来源改名为「IPv4 IP 段设置」和「IPv6 IP 段设置」；把其中一栏设为「关闭」并保存后，已经写进 AdGuard Home 的那一族记录会当场收回，不再等下一轮测速。域名解析里的 A / AAAA 记录不受影响。设置项的位置、字段、默认值没变，升级后不用重填。
disable_authorization_path=true
