desc=自动测速选取最快 Cloudflare 边缘 IP，写入 AdGuard Home DNS 重写并同步到自有域名 DDNS，生成优选域名。
platform=x86
source=thirdparty
maintainer=Stone
distributor=Stone
desktop_uidir=ui
desktop_applaunchname=cf-ddns-sidecar.Application
ctl_stop=true
service_port=8080
checkport=false
os_min_version=1.2.0
changelog=新增 IPv6 优选：测速时可顺带测出 Cloudflare v6 节点，写进 AdGuard 与域名的 AAAA 记录（域名解析页新增「记录类型」，A / AAAA 可选，四家服务商都支持）。同时修掉 v6 探测误报「全部直连」的红字、以及采样量过小导致可用节点难捞出来的问题
disable_authorization_path=true
