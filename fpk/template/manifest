appname=cf-ddns-sidecar
version={{VERSION}}
display_name=Cloudflare 优选 DDNS
desc=自动测速选取最快 Cloudflare 边缘 IP，写入 AdGuard Home DNS 重写并同步到自有域名 DDNS，生成优选域名。
platform=x86
source=thirdparty
maintainer=Stone
distributor=Stone
desktop_uidir=ui
desktop_applaunchname=cf-ddns-sidecar.Application
ctl_stop=true
service_port=8080
checkport=false
os_min_version=1.2.0
changelog=AdGuard 那块多了一条独立的写入通道：把别人维护的 hosts 清单（比如 hosts.gitcdn.top 那种）填进来，每轮测速顺手同步进重写表。它和「加速域名」互不影响——同名时用测速结果那个 IP、清单里那条跳过并记一笔；0.0.0.0 和 127.0.0.1 这种「别解析」的拦截条目不写（跳过并记数），IPv6 地址照写。拉取失败时用上一轮的结果，已有记录一条不删；关掉开关后下一轮会把它写过的记录整批收回，而你自己在 AdGuard 后台加的记录始终不碰。要注意填的是清单文件本身（https://hosts.gitcdn.top/hosts.txt），填根路径那是一个网页、界面会直接提示。
disable_authorization_path=true
