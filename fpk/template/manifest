appname=cf-ddns-sidecar
version={{VERSION}}
display_name=Cloudflare 优选 DDNS
desc=自动测速选取最快 Cloudflare 边缘 IP，写入 AdGuard Home DNS 重写并同步到自有域名 DDNS，生成优选域名。
platform=x86
source=thirdparty
maintainer=Stone
distributor=Stone
desktop_uidir=ui
desktop_applaunchname=cf-ddns-sidecar.Application
ctl_stop=true
service_port=8080
checkport=false
os_min_version=1.2.0
changelog=打开 GitHub hosts 源的开关，现在会立刻同步一次，不用等到下一轮测速。点开之后一两秒内，清单里的域名就出现在 AdGuard 重写表里，界面会报「已写入 AdGuard：N 条（含 M 条 hosts 源）」，卡片下面那行「上次同步」也当场刷新；之后仍然跟着每轮测速（默认 60 分钟）定时同步。链接打不开、或者一条都拉不到时不会清掉已有记录，下一轮再试。其余行为与 v1.7.7 一致。
disable_authorization_path=true
