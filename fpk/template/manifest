appname=cf-ddns-sidecar
version={{VERSION}}
display_name=Cloudflare 优选 DDNS
desc=自动测速选取最快 Cloudflare 边缘 IP，写入 AdGuard Home DNS 重写并同步到自有域名 DDNS，生成优选域名。
platform=x86
source=thirdparty
maintainer=Stone
distributor=Stone
desktop_uidir=ui
desktop_applaunchname=cf-ddns-sidecar.Application
ctl_stop=true
service_port=8080
checkport=false
os_min_version=1.2.0
changelog=域名解析的「记录类型」多了第三档 A + AAAA：一轮测速后 A 和 AAAA 两族一起更新，不用再二选一（v1.7.0 里「选了 AAAA 之后 A 记录就不再更新」的取舍已补掉）。某一族没测出结果时只跳过那一族，另一族照常更新、原有记录不会被删；「测试密钥」和「立即更新一次」在 A + AAAA 下按族分别显示现在指向哪儿、会写入几条、哪一族被跳过及原因
disable_authorization_path=true
