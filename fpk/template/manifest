checkport=false
os_min_version=1.2.0
changelog=这一版修了几处用起来别扭的地方，另加一个筛选条件。设置项的位置、字段、默认值没变，升级后不用重填。一、桌面图标下的名字改成短版「优选 IP · DDNS」，不再折成两行。二、从左到右切页面时内容不再左右跳。三、概览页「当前最优 IP」在测出 IPv6 时多显示一行，没有就只显示 IPv4。四、鼠标停在任意一个 IP 上会出现复制按钮，点一下就复制。五、「域名解析」新增「最低下载速度」：低于它的节点不写进解析，设 5 条时可能只写 4 条；一条都不达标就不动现有解析，日志会写明是门槛的事。
disable_authorization_path=true
