#!/bin/bash

# 飞牛生命周期脚本：处理 start / stop / status。
# 首次 start 时：创建数据目录 → 生成 ddns.env 示例配置（幂等，可重复执行）。
# v1.1.0 起改为单容器架构，所有数据统一放在 share/<appname>/data 一个目录。

APP_NAME="${TRIM_APPNAME:-cf-ddns-sidecar}"
# 飞牛数据共享目录的稳定软链路径（官方文档：/var/apps/<appname>/share/<share name>）
SHARE_ROOT="/var/apps/${APP_NAME}/share/${APP_NAME}"
# v1.1.0～v1.3.2 的数据位置。平台删 /var/apps/<app> 时它跟着一起没，
# 所以从 v1.4.0 起不再是运行时的数据位置，只作为**搬迁来源**保留。
LEGACY_DATA_ROOT="${SHARE_ROOT}/data"
# v1.4.0～v1.4.1 的数据位置（真实目录，没有链到存储卷）。同样只作为搬迁来源。
V14_DATA_ROOT="/var/apps/${APP_NAME}-data"
# v1.5.0 起的数据位置：飞牛官方给的运行数据目录。
#
# 官方文档写明安装后 /var/apps/<app>/ 下由平台自动建好
# `var -> /vol{n}/@appdata/<app>`，变量名 TRIM_PKGVAR，并要求「不要硬编码路径」。
# 也就是说「把数据放到存储卷上」从来不需要我们自己 mkdir /vol1/... 再建软链。
#
# 变量为空（老飞牛、或不是用安装包装的）时退回 v1.4.x 的旧路径，行为完全不变。
VAR_ROOT="${TRIM_PKGVAR:-}"
if [ -n "$VAR_ROOT" ]; then
    DATA_ROOT="$VAR_ROOT"
else
    DATA_ROOT="/var/apps/${APP_NAME}-data"
fi
FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

fail() {
    # 优先写飞牛给的日志文件（会展示在界面上）；写不了再退到 stderr。
    # 两段都要有兜底：v1.5.0 探针测试里实测发现，非 root 身份下 `> /dev/stderr`
    # 会被拒（can't create /dev/stderr: Permission denied），于是「启动失败」
    # 这件事本身也没人知道——这正是「静默失败」的另一半。
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ] \
        && printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE" 2>/dev/null; then
        :
    else
        printf '[cf-ddns-sidecar][错误] %s\n' "$1" >&2 2>/dev/null || true
    fi
    exit 1
}

# —— 「数据到底在哪儿」的记账（v1.4.2）——
#
# 教训：v1.3.2～v1.4.1 三版都号称把数据/备份搬到了存储卷，2026-11-17 真机一翻
# 文件管理器，`cf-ddns-sidecar-data` 和 `cf-ddns-sidecar-backup` **根本不在盘上**。
# 真因：`/volN` 根目录属于 root，而本脚本以 `run-as: package` 的普通用户执行，
# `mkdir -p /vol1/...` 直接被拒；以前那里写着 `2>/dev/null`，错误被吞掉，于是
# 每一版都「以为搬了、其实没搬」，日志里一个字都没有——用户和我只能靠翻文件管理器猜。
#
# 现在改成：脚本把判断结果写进数据目录里的 location-status.txt，由容器里的程序
# 读出来打进「运行日志」。**脚本负责说实话，程序负责让用户看得见。**
LOC_DATA_ERR=""
LOC_BACKUP_ERR=""

# 把本次「安置」的结果落盘（每次 init 覆盖成最新一份，历史没有价值）。
# 必须放在数据目录已经存在之后调用——文件本身要写进数据目录。
record_location() {
    local f="${DATA_ROOT}/location-status.txt"
    [ -d "$DATA_ROOT" ] || return 0

    local dkind="real" bkind="real"
    [ -L "$DATA_ROOT" ] && dkind="symlink"
    [ -n "${BACKUP_ROOT:-}" ] && [ -L "$BACKUP_ROOT" ] && bkind="symlink"

    local ts dreal breal
    ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
    dreal="$(readlink -f "$DATA_ROOT" 2>/dev/null)"
    breal="$(readlink -f "${BACKUP_ROOT:-}" 2>/dev/null)"

    {
        echo "time=${ts}"
        echo "var_root=${VAR_ROOT:-<未设置>}"
        echo "data_host=${DATA_ROOT}"
        echo "data_kind=${dkind}"
        echo "data_real=${dreal}"
        echo "data_error=${LOC_DATA_ERR}"
        echo "migrate=${MIGRATE_NOTE:-<没有需要搬的旧数据>}"
        echo "backup_host=${BACKUP_ROOT:-}"
        echo "backup_kind=${bkind}"
        echo "backup_real=${breal}"
        echo "backup_error=${LOC_BACKUP_ERR}"
    } > "$f" 2>/dev/null || true
    # 容器里的程序是 uid 1000，读不到就别谈「说出来」了
    chmod 0644 "$f" 2>/dev/null || true
}

# 从旧版（双容器：subject/ sidecar/ conf/ 三个目录）升级时，把已有配置搬到新目录，
# 避免用户升级后配置“看不见了”又得重填一遍。
migrate_legacy() {
    local old_env="${SHARE_ROOT}/sidecar/ddns.env"
    local new_env="${DATA_ROOT}/ddns.env"

    if [ -f "$old_env" ] && [ ! -f "$new_env" ]; then
        cp -p "$old_env" "$new_env" 2>/dev/null \
            && echo "[cf-ddns-sidecar] 已迁移旧配置: $old_env -> $new_env"
    fi

    local old_state="${SHARE_ROOT}/sidecar/state.json"
    local new_state="${DATA_ROOT}/sidecar-state.json"
    if [ -f "$old_state" ] && [ ! -f "$new_state" ]; then
        cp -p "$old_state" "$new_state" 2>/dev/null \
            && echo "[cf-ddns-sidecar] 已迁移旧状态: $old_state -> $new_state"
    fi
}

# 清理 v1.0.x 双容器架构遗留的主体容器。
# 旧版 compose 里有一个独立的 cf-dns-select 容器，新版把它合进了本容器；
# 升级后旧容器不会被新 compose 管理，会残留并继续占用 8080，导致新容器起不来。
cleanup_legacy_container() {
    if docker inspect cf-dns-select >/dev/null 2>&1; then
        docker rm -f cf-dns-select >/dev/null 2>&1 \
            && echo "[cf-ddns-sidecar] 已清理旧版主体容器 cf-dns-select（v1.0.x 遗留）"
    fi
}

# 把老位置的数据搬到 dest。
#
# 两个来源，按「越新越优先」：v1.4.x 的 /var/apps/<app>-data，再往前的
# share/<app>/data。只在「dest 还是空的」时才搬。两个判据都不能省：
#   · 不判 dest 空 → 会拿老数据盖掉新数据（新位置才是最新的）；
#   · 不判来源有东西 → 全新安装时白跑一趟 cp，还会把 dest 的 mtime 搅乱。
# 用「目录是否为空」而不是「有没有 config.json」：全新安装时老位置可能只有
# 一个 ddns.env 示例，那种也要搬——否则新位置会再生成一份，端口就被重置了。
#
# 搬失败不静默：写进 MIGRATE_NOTE，由 record_location 落盘、程序打进运行日志。
# 前三个版本的教训就是「兜底方向是对的，但它不说话」。
MIGRATE_NOTE=""
migrate_from_legacy_data() {
    local dest="$1" src
    [ -n "$dest" ] || return 0
    [ -z "$(ls -A "$dest" 2>/dev/null)" ] || return 0

    for src in "$V14_DATA_ROOT" "$LEGACY_DATA_ROOT"; do
        [ -n "$(ls -A "$src" 2>/dev/null)" ] || continue
        if cp -a "${src}"/. "$dest"/ 2>/dev/null; then
            MIGRATE_NOTE="已把 ${src} 的数据搬到 ${dest}"
        else
            MIGRATE_NOTE="把 ${src} 的数据复制到 ${dest} 失败（旧文件没动，新位置可能是半份）"
        fi
        return 0
    done
    return 0
}

# —— v1.5.0 探针：直接用飞牛官方的 TRIM_PKGVAR ——
#
# v1.6.4：以前这里还有三个自造函数（detect_volume_root / ensure_data_root /
# ensure_backup_root），干的是「在 /vol1 根下建目录、再软链过去」。它们只在
# TRIM_PKGVAR 为空时才被调用，而真机上这个变量一定有值——所以那段代码一次
# 都没执行过。更要紧的是：它想做的事真机上根本做不到（/vol1 属 root、本脚本
# 是 package 用户，三次都是 Permission denied，错误又被 2>/dev/null 吞了，
# 于是每一版都「以为搬了」）。留着它只会让人以为还有这层保护，已整段删除。
#
# 这条分支只做三件事，少一件就会出现「装完配置是空的」：
#   ① 目录先建出来。docker 建容器时若挂载源不存在，会自己建一个 root 属主的
#      空目录，容器里的 uid 1000 就写不进去；
#   ② 老位置的数据搬过来。换了路径却不搬数据，等于配置凭空消失（v1.4.0 踩过）；
#   ③ **验证真的能写**。mkdir 成功不代表能写，ACL 要到写那一刻才拦——这正是
#      本次要验证的第二个问题，所以必须真写一个探针文件，不能只看目录在不在。
#
# 探针失败时**不切换路径**：compose 已经按 ${TRIM_PKGVAR} 挂上了，脚本要是
# 偷偷改写到旧路径，就成了「向导里设了密码、程序读不到」那个更隐蔽的坑。
# 正确做法是把原因写进账本，让程序在运行日志里说出来。
init_on_platform_var() {
    local err=""

    if ! err="$(mkdir -p "$VAR_ROOT" 2>&1)"; then
        LOC_DATA_ERR="建不了官方数据目录 ${VAR_ROOT}（${err}）"
        echo "[cf-ddns-sidecar] 警告：${LOC_DATA_ERR}"
        return 0
    fi

    migrate_from_legacy_data "$VAR_ROOT"

    # 用外部命令 touch 而不是 `: > file`：shell 重定向失败时错误打在 shell 自己的
    # stderr 上，`$( )` 捕获不到，日志里就只剩「（）」这对空括号；touch 的报错是可捕获的。
    if ! err="$(touch "${VAR_ROOT}/.write-probe" 2>&1)"; then
        LOC_DATA_ERR="官方数据目录 ${VAR_ROOT} 存在但不让容器用户写（${err}）"
        echo "[cf-ddns-sidecar] 警告：${LOC_DATA_ERR}"
        return 0
    fi
    rm -f "${VAR_ROOT}/.write-probe" 2>/dev/null

    echo "[cf-ddns-sidecar] 数据目录（官方 TRIM_PKGVAR）：${VAR_ROOT}"
}

# 首次启动初始化：建目录 + 迁移旧数据 + 生成示例配置（幂等）
init_on_start() {
    if [ -n "$VAR_ROOT" ]; then
        # 官方目录在手（真机上一定如此）：先建出来、把老数据搬过来、再验一下能写。
        init_on_platform_var
    fi
    # TRIM_PKGVAR 为空时 DATA_ROOT 就是 /var/apps/<app>-data，直接建出来即可。
    # v1.6.4 之前这里还会「在 /vol1 根下建目录再软链过去」，那段代码从来没
    # 执行过（原因见上面 init_on_platform_var 的注释），已删除。
    mkdir -p "$DATA_ROOT" || fail "无法创建数据目录: $DATA_ROOT"

    # 备份根目录（v1.3.1 起；v1.3.2 起链到存储卷上）。
    #
    # 这里必须由脚本预先建好并改好属主，原因有两个：
    #   ① 挂载源不存在时 docker 会自动建，但建出来是 root:root 0755，
    #      有的平台版本会在「挂载源不存在」这一步直接拒绝建容器，提前建好更稳；
    #   ② v1.3.2 起程序自己也会往这里写备份（不再只靠 upgrade_init，因为真机
    #      验证明明升级了、那个脚本却没跑）。容器里的程序是 uid 1000，
    #      root:root 0755 的目录它写不进去，于是「备份目录在、但永远是空的」，
    #      恢复时又是两手空空。
    #
    # 属主对齐失败才退回放开 0777——宁可权限宽一点，也不要让备份悄悄写不进去。
    # 这一段整体失败也不影响启动。
    # v1.6.3：备份改到官方建议的位置 —— 数据根目录下的 backup 子目录。
    #
    # 必须和 compose 的 `${TRIM_PKGVAR:-…}/backup:/app/backup` 保持一致。
    # 两边不一致的后果很难查：脚本把 A 目录建好、改好属主，容器挂的却是 B，
    # 现象是「日志说备份目录可用，程序却报写不进去」——v1.4.0 就是这么坏的。
    if [ -n "$VAR_ROOT" ]; then
        BACKUP_ROOT="${VAR_ROOT}/backup"
    else
        # 平台没给 TRIM_PKGVAR（老版本飞牛，或用户自己写 compose 跑）：留在
        # v1.4.x 那个兄弟目录。以前这里还会试着软链到存储卷，那段代码真机上
        # 从来没成功过，v1.6.4 已删——不再假装有这层保护。
        BACKUP_ROOT="/var/apps/${APP_NAME}-backup"
    fi
    mkdir -p "$BACKUP_ROOT" 2>/dev/null \
        || LOC_BACKUP_ERR="建不了备份目录 ${BACKUP_ROOT}"
    # 注意：chown 要作用在真实目录上。符号链接本身 chown 只是改链接的属主，
    # 容器写的是链接指向的那个目录，权限还是没放开。
    BACKUP_REAL="$(readlink -f "$BACKUP_ROOT" 2>/dev/null)"
    [ -n "$BACKUP_REAL" ] || BACKUP_REAL="$BACKUP_ROOT"
    if mkdir -p "$BACKUP_REAL" 2>/dev/null; then
        if ! chown 1000:1000 "$BACKUP_REAL" 2>/dev/null; then
            chmod 0777 "$BACKUP_REAL" 2>/dev/null
        fi
    fi

    cleanup_legacy_container
    migrate_legacy

    # 容器内以非 root（uid 1000）运行，需保证它写得进数据目录
    # （config.json、ddns.env、测速工作目录都要往里写），否则配置存不下来。
    # 与备份目录同一套做法：属主能对齐就对齐，对齐不了才放开 0777。
    # 必须作用在 readlink -f 之后的真实目录上——chmod 会跟随软链，但 chown 不会，
    # 直接 chown 软链只是改了链接自己的属主，容器照样写不进去。
    DATA_REAL="$(readlink -f "$DATA_ROOT" 2>/dev/null)"
    [ -n "$DATA_REAL" ] || DATA_REAL="$DATA_ROOT"
    if mkdir -p "$DATA_REAL" 2>/dev/null; then
        if ! chown 1000:1000 "$DATA_REAL" 2>/dev/null; then
            chmod 0777 "$DATA_REAL" 2>/dev/null
        fi
    fi

    # 生成 ddns.env 示例（仅当不存在时），避免配置缺失导致排错时无从下手。
    # 注意：这里故意把「服务商 / 域名 / 间隔」也注释掉——如果写成实值，
    # 程序首次启动会把占位域名 cf.example.com 当成真域名去推解析。
    if [ ! -f "${DATA_ROOT}/ddns.env" ]; then
        cat > "${DATA_ROOT}/ddns.env" <<'EOF'
# ============================================================
# cf-ddns-sidecar 密钥与基础配置
#
# 正常情况下你不需要改这个文件：
#   打开后台 http://飞牛IP:端口 （端口在「应用设置」里，默认 8080），
#   所有项都在界面里填，保存后自动写到这里。
# 这个文件只是让人能一眼看到、或者用文本编辑器批量改。
#
# 下面这些项同时也是「安装向导 / 应用设置」的入口：
# 从设置里保存后，程序启动时会应用一次并清掉 CFDDNS_APPLY_ENV 标记。
# ============================================================

# --- 自动化标记：设置页保存后置 1，程序应用完改回 0，不要手改 ---
CFDDNS_APPLY_ENV=0

# --- 后台端口（默认 8080；改了要重启应用，桌面图标会一起更新）---
CFDDNS_PORT=8080

# --- DDNS 服务商（cloudflare / aliyun / dnspod / huawei）---
#CFDDNS_PROVIDER=cloudflare

# --- 优选域名（A 记录将指向最优 IP，如 cf.example.com）---
#CFDDNS_DOMAIN=

# --- 自动测速间隔（分钟，0 表示不自动测）---
#CFDDNS_INTERVAL_MINUTES=60

# --- Cloudflare 密钥（provider=cloudflare 时必填）---
#CF_API_TOKEN=
#CF_ZONE_ID=

# --- 阿里云密钥（provider=aliyun 时必填）---
#ALIYUN_ACCESS_KEY_ID=
#ALIYUN_ACCESS_KEY_SECRET=
# 多级公共后缀（如 example.com.cn）才需要，一般留空
#ALIYUN_ROOT_DOMAIN=

# --- 腾讯云 DNSPod 密钥（provider=dnspod 时必填）---
#TENCENT_SECRET_ID=
#TENCENT_SECRET_KEY=
# 多级公共后缀才需要，一般留空
#DNSPOD_ROOT_DOMAIN=

# --- 华为云密钥（provider=huawei 时必填）---
#HUAWEI_AK=
#HUAWEI_SK=
#HUAWEI_ZONE_ID=
EOF
        echo "[cf-ddns-sidecar] 已生成示例配置: ${DATA_ROOT}/ddns.env"
    fi

    # 保证容器内非 root 用户可读取配置（防止 umask 077 导致 0600）
    chmod 0644 "${DATA_ROOT}/ddns.env" 2>/dev/null

    # Dashboard 登录密码：只在首次安装时生成一次，之后保持不变。
    # 主体默认每次启动都会重新生成随机密码，用户难以使用；
    # 这里落盘一份固定密码，容器启动时由 entrypoint 读取并注入。
    local pass_file="${DATA_ROOT}/dashboard-password"
    if [ ! -f "$pass_file" ]; then
        (tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 16) > "$pass_file" 2>/dev/null || true
        chmod 0644 "$pass_file" 2>/dev/null
        echo "[cf-ddns-sidecar] 已生成 Dashboard 初始密码: $pass_file"
    fi

    sync_port_to_entry

    # 最后一步：把「这次到底把数据和备份放哪儿了」写成一份小账本，
    # 容器里的程序启动时读出来打进运行日志——用户不用翻文件管理器就能知道真相。
    # 放在最后是因为它要等数据目录和备份目录都安置完，才能记全两边的情况。
    # 写不进去也不影响启动（容器里还有自己的日志可以看）。
    record_location
}

# 端口同步：ddns.env 里的 CFDDNS_PORT 是唯一来源（默认 8080）。
# 每次启动都对齐一次桌面入口，图标就不会指向旧端口。
#
# 为什么是「模板写占位符」+「启动时再对齐」两道：
#   · 飞牛 1.1.8 起支持在 app/ui/config 里写 ${wizard_port}，生成入口时自动
#     替换成用户填的端口。这是首选路径：改端口即时生效，不依赖本脚本。
#   · 但更老的飞牛不认占位符（会当字面量留着），用户把端口留空时飞牛会替换成
#     空串。这两种情况靠下面的 sed 兜底改回真实端口。
#   两道缺任何一道，「改了端口 → 点图标打不开」就会复现（v1.0.0 的真实故障）。
#   app/ui/config → "port": "xxxx"    飞牛点图标时用它拼 URL
#   manifest      → service_port = xx
sync_port_to_entry() {
    local env_file="${DATA_ROOT}/ddns.env"
    local port=""

    if [ -f "$env_file" ]; then
        port=$(grep -E '^CFDDNS_PORT=' "$env_file" 2>/dev/null | tail -n 1 | cut -d= -f2 | tr -d ' \r')
    fi
    case "$port" in
        ''|*[!0-9]*) port=8080 ;;
    esac
    if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
        port=8080
    fi

    local ui_conf="${TRIM_APPDEST}/ui/config"
    if [ -f "$ui_conf" ]; then
        # 这里用 [^\"]* 而不是 [0-9]+，是为了同时兜住两种「port 不是数字」的情况：
        #   ① 模板里写的是占位符 ${wizard_port}，飞牛版本低于 1.1.8 时不认识它，
        #      会原样留在文件里（匹配不到纯数字）；
        #   ② 用户在向导里把端口留空，飞牛替换成了空串。
        # 两种情况都必须能改成本次真实端口，否则点图标连的是空端口/字面量，必然打不开。
        sed -i -E "s/(\"port\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")/\1${port}\2/" "$ui_conf" 2>/dev/null \
            || echo "[cf-ddns-sidecar] 警告：无法写入 $ui_conf"
    fi

    local mf="${TRIM_APPDEST}/../manifest"
    if [ -f "$mf" ]; then
        sed -i -E "s/^service_port[[:space:]]*=.*/service_port = ${port}/" "$mf" 2>/dev/null \
            || echo "[cf-ddns-sidecar] 警告：无法写入 $mf"
    fi

    echo "[cf-ddns-sidecar] 后台端口: ${port}"
}

is_docker_running() {
    local container_name=""

    if [ -f "$FILE_PATH" ]; then
        container_name=$(grep "container_name" "$FILE_PATH" | head -n 1 | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$container_name" ]; then
        docker inspect "$container_name" 2>/dev/null | grep -q '"Status": "running"' || return 1
        return 0
    fi
    return 1
}

case "$1" in
    start)
        # docker application will be started by appcenter
        init_on_start
        exit 0
        ;;
    init)
        # 供 install_init 在安装阶段提前生成配置（共享目录已就绪时）
        init_on_start
        exit 0
        ;;
    stop)
        # docker application will be stopped by appcenter
        exit 0
        ;;
    status)
        if is_docker_running; then
            exit 0
        else
            exit 3
        fi
        ;;
    *)
        exit 1
        ;;
esac
