#!/bin/bash

# 飞牛生命周期脚本：处理 start / stop / status。
# 首次 start 时：创建数据目录 → 生成 ddns.env 示例配置（幂等，可重复执行）。
# v1.1.0 起改为单容器架构，所有数据统一放在 share/<appname>/data 一个目录。

APP_NAME="${TRIM_APPNAME:-cf-ddns-sidecar}"
# 飞牛数据共享目录的稳定软链路径（官方文档：/var/apps/<appname>/share/<share name>）
SHARE_ROOT="/var/apps/${APP_NAME}/share/${APP_NAME}"
DATA_ROOT="${SHARE_ROOT}/data"
FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

fail() {
    echo "$1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
}

# 从旧版（双容器：subject/ sidecar/ conf/ 三个目录）升级时，把已有配置搬到新目录，
# 避免用户升级后配置“看不见了”又得重填一遍。
migrate_legacy() {
    local old_env="${SHARE_ROOT}/sidecar/ddns.env"
    local new_env="${DATA_ROOT}/ddns.env"

    if [ -f "$old_env" ] && [ ! -f "$new_env" ]; then
        cp -p "$old_env" "$new_env" 2>/dev/null \
            && echo "[cf-ddns-sidecar] 已迁移旧配置: $old_env -> $new_env"
    fi

    local old_state="${SHARE_ROOT}/sidecar/state.json"
    local new_state="${DATA_ROOT}/sidecar-state.json"
    if [ -f "$old_state" ] && [ ! -f "$new_state" ]; then
        cp -p "$old_state" "$new_state" 2>/dev/null \
            && echo "[cf-ddns-sidecar] 已迁移旧状态: $old_state -> $new_state"
    fi
}

# 清理 v1.0.x 双容器架构遗留的主体容器。
# 旧版 compose 里有一个独立的 cf-dns-select 容器，新版把它合进了本容器；
# 升级后旧容器不会被新 compose 管理，会残留并继续占用 8080，导致新容器起不来。
cleanup_legacy_container() {
    if docker inspect cf-dns-select >/dev/null 2>&1; then
        docker rm -f cf-dns-select >/dev/null 2>&1 \
            && echo "[cf-ddns-sidecar] 已清理旧版主体容器 cf-dns-select（v1.0.x 遗留）"
    fi
}

# 探测「用户存储卷」的根，例如 /vol1。
#
# 为什么需要它：应用自己的一切（包括数据目录 /var/apps/<app>/share/<app>）都在
# 存储卷上，飞牛会把它当成「应用的数据」在卸载/升级时清掉；而卷根下的普通目录
# 属于用户，不归应用管，不会跟着没。
#
# 探测方式不是猜：/var/apps/<app>/share/<share> 在飞牛上是指向 /volN/@appshare/<app>
# 的软链（官方文档里的稳定路径就是这么来的），顺着它 readlink -f 就能拿到真实卷号。
# 拿不到再退一步直接看 /vol1../vol9 哪个在。
detect_volume_root() {
    local p real tail i
    for p in "$SHARE_ROOT" "$DATA_ROOT"; do
        real="$(readlink -f "$p" 2>/dev/null)"
        case "$real" in
            /vol[0-9]*/*)
                tail="${real#/}"          # vol1/@appshare/cf-ddns-sidecar
                echo "/${tail%%/*}"       # /vol1
                return 0
                ;;
        esac
    done
    for i in 1 2 3 4 5 6 7 8 9; do
        if [ -d "/vol${i}" ]; then
            echo "/vol${i}"
            return 0
        fi
    done
    echo ""
}

# 备份根目录 /var/apps/<app>-backup 的安置。
#
# 这个目录经历过两次搬迁，每次都是因为「备份放在会被删的那一层里」：
#   v1.1.1 放在 share/<app>-backup-<时间>/  —— 在应用目录里面，整层被删就跟着没；
#   v1.3.1 搬到 /var/apps/<app>-backup      —— 是应用目录的兄弟，但仍在 /var/apps 下；
#   v1.3.2 起再把它**做成指向存储卷的符号链接** —— /var/apps 整个被清也活得下来。
#
# 容器里看到的路径不变（/app/backup 由 compose 挂 /var/apps/<app>-backup），
# 程序一行都不用改：docker 会顺着符号链接找到卷上的真实目录。
#
# 任何一步失败都退回「老老实实用真实目录」——备份少一层保险可以接受，
# 把备份弄丢、或者让容器因为挂载源异常而起不来，绝不能接受。
ensure_backup_root() {
    local target="$1"   # 为空表示没探到存储卷，只能留在原地

    if [ -z "$target" ]; then
        mkdir -p "$BACKUP_ROOT" 2>/dev/null
        return 0
    fi

    # 已经是指向正确位置的符号链接：什么都不做（幂等，每次启动都会跑到这里）
    if [ -L "$BACKUP_ROOT" ] && [ "$(readlink "$BACKUP_ROOT" 2>/dev/null)" = "$target" ]; then
        return 0
    fi

    if ! mkdir -p "$target" 2>/dev/null; then
        mkdir -p "$BACKUP_ROOT" 2>/dev/null
        return 0
    fi

    # 原来是个真实目录（v1.3.1/v1.3.2 早期建的，里面很可能已经有备份了）：
    # 先把内容整份搬过去，搬成功才换成软链；任何一步不成功就原地不动。
    if [ -d "$BACKUP_ROOT" ] && [ ! -L "$BACKUP_ROOT" ]; then
        if ! cp -a "$BACKUP_ROOT"/. "$target"/ 2>/dev/null; then
            echo "[cf-ddns-sidecar] 备份目录搬迁失败（复制不成功），仍旧留在 ${BACKUP_ROOT}"
            return 0
        fi
        if ! mv "$BACKUP_ROOT" "${BACKUP_ROOT}.migrating" 2>/dev/null; then
            return 0
        fi
        if ! ln -s "$target" "$BACKUP_ROOT" 2>/dev/null; then
            # 链接建不起来就把原目录搬回去，别留下「什么都没有」的局面
            mv "${BACKUP_ROOT}.migrating" "$BACKUP_ROOT" 2>/dev/null
            return 0
        fi
        rm -rf "${BACKUP_ROOT}.migrating" 2>/dev/null
        echo "[cf-ddns-sidecar] 备份目录已搬到存储卷：${BACKUP_ROOT} -> ${target}"
        return 0
    fi

    ln -s "$target" "$BACKUP_ROOT" 2>/dev/null
    return 0
}

# 首次启动初始化：建目录 + 迁移旧数据 + 生成示例配置（幂等）
init_on_start() {
    mkdir -p "$DATA_ROOT" || fail "无法创建数据目录: $DATA_ROOT"

    # 备份根目录（v1.3.1 起；v1.3.2 起链到存储卷上）。
    #
    # 这里必须由脚本预先建好并改好属主，原因有两个：
    #   ① 挂载源不存在时 docker 会自动建，但建出来是 root:root 0755，
    #      有的平台版本会在「挂载源不存在」这一步直接拒绝建容器，提前建好更稳；
    #   ② v1.3.2 起程序自己也会往这里写备份（不再只靠 upgrade_init，因为真机
    #      验证明明升级了、那个脚本却没跑）。容器里的程序是 uid 1000，
    #      root:root 0755 的目录它写不进去，于是「备份目录在、但永远是空的」，
    #      恢复时又是两手空空。
    #
    # 属主对齐失败才退回放开 0777——宁可权限宽一点，也不要让备份悄悄写不进去。
    # 这一段整体失败也不影响启动。
    BACKUP_ROOT="/var/apps/${APP_NAME}-backup"
    VOL_ROOT="$(detect_volume_root)"
    if [ -n "$VOL_ROOT" ]; then
        ensure_backup_root "${VOL_ROOT}/${APP_NAME}-backup"
    else
        ensure_backup_root ""
    fi
    # 注意：chown 要作用在真实目录上。符号链接本身 chown 只是改链接的属主，
    # 容器写的是链接指向的那个目录，权限还是没放开。
    BACKUP_REAL="$(readlink -f "$BACKUP_ROOT" 2>/dev/null)"
    [ -n "$BACKUP_REAL" ] || BACKUP_REAL="$BACKUP_ROOT"
    if mkdir -p "$BACKUP_REAL" 2>/dev/null; then
        if ! chown 1000:1000 "$BACKUP_REAL" 2>/dev/null; then
            chmod 0777 "$BACKUP_REAL" 2>/dev/null
        fi
    fi

    cleanup_legacy_container
    migrate_legacy

    # 容器内以非 root（uid 1000）运行，需保证其可写数据目录
    # （主体的 config.json、旁路的 state.json 都要落盘），否则配置无法保存。
    chmod 0777 "$DATA_ROOT" 2>/dev/null

    # 生成 ddns.env 示例（仅当不存在时），避免配置缺失导致排错时无从下手。
    # 注意：这里故意把「服务商 / 域名 / 间隔」也注释掉——如果写成实值，
    # 程序首次启动会把占位域名 cf.example.com 当成真域名去推解析。
    if [ ! -f "${DATA_ROOT}/ddns.env" ]; then
        cat > "${DATA_ROOT}/ddns.env" <<'EOF'
# ============================================================
# cf-ddns-sidecar 密钥与基础配置
#
# 正常情况下你不需要改这个文件：
#   打开后台 http://飞牛IP:端口 （端口在「应用设置」里，默认 8080），
#   所有项都在界面里填，保存后自动写到这里。
# 这个文件只是让人能一眼看到、或者用文本编辑器批量改。
#
# 下面这些项同时也是「安装向导 / 应用设置」的入口：
# 从设置里保存后，程序启动时会应用一次并清掉 CFDDNS_APPLY_ENV 标记。
# ============================================================

# --- 自动化标记：设置页保存后置 1，程序应用完改回 0，不要手改 ---
CFDDNS_APPLY_ENV=0

# --- 后台端口（默认 8080；改了要重启应用，桌面图标会一起更新）---
CFDDNS_PORT=8080

# --- DDNS 服务商（cloudflare / aliyun / dnspod / huawei）---
#CFDDNS_PROVIDER=cloudflare

# --- 优选域名（A 记录将指向最优 IP，如 cf.example.com）---
#CFDDNS_DOMAIN=

# --- 自动测速间隔（分钟，0 表示不自动测）---
#CFDDNS_INTERVAL_MINUTES=60

# --- Cloudflare 密钥（provider=cloudflare 时必填）---
#CF_API_TOKEN=
#CF_ZONE_ID=

# --- 阿里云密钥（provider=aliyun 时必填）---
#ALIYUN_ACCESS_KEY_ID=
#ALIYUN_ACCESS_KEY_SECRET=
# 多级公共后缀（如 example.com.cn）才需要，一般留空
#ALIYUN_ROOT_DOMAIN=

# --- 腾讯云 DNSPod 密钥（provider=dnspod 时必填）---
#TENCENT_SECRET_ID=
#TENCENT_SECRET_KEY=
# 多级公共后缀才需要，一般留空
#DNSPOD_ROOT_DOMAIN=

# --- 华为云密钥（provider=huawei 时必填）---
#HUAWEI_AK=
#HUAWEI_SK=
#HUAWEI_ZONE_ID=
EOF
        echo "[cf-ddns-sidecar] 已生成示例配置: ${DATA_ROOT}/ddns.env"
    fi

    # 保证容器内非 root 用户可读取配置（防止 umask 077 导致 0600）
    chmod 0644 "${DATA_ROOT}/ddns.env" 2>/dev/null

    # Dashboard 登录密码：只在首次安装时生成一次，之后保持不变。
    # 主体默认每次启动都会重新生成随机密码，用户难以使用；
    # 这里落盘一份固定密码，容器启动时由 entrypoint 读取并注入。
    local pass_file="${DATA_ROOT}/dashboard-password"
    if [ ! -f "$pass_file" ]; then
        (tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 16) > "$pass_file" 2>/dev/null || true
        chmod 0644 "$pass_file" 2>/dev/null
        echo "[cf-ddns-sidecar] 已生成 Dashboard 初始密码: $pass_file"
    fi

    sync_port_to_entry
}

# 端口同步：ddns.env 里的 CFDDNS_PORT 是唯一来源（默认 8080）。
# 每次启动都对齐一次桌面入口，图标就不会指向旧端口。
#
# 为什么是「模板写占位符」+「启动时再对齐」两道：
#   · 飞牛 1.1.8 起支持在 app/ui/config 里写 ${wizard_port}，生成入口时自动
#     替换成用户填的端口。这是首选路径：改端口即时生效，不依赖本脚本。
#   · 但更老的飞牛不认占位符（会当字面量留着），用户把端口留空时飞牛会替换成
#     空串。这两种情况靠下面的 sed 兜底改回真实端口。
#   两道缺任何一道，「改了端口 → 点图标打不开」就会复现（v1.0.0 的真实故障）。
#   app/ui/config → "port": "xxxx"    飞牛点图标时用它拼 URL
#   manifest      → service_port = xx
sync_port_to_entry() {
    local env_file="${DATA_ROOT}/ddns.env"
    local port=""

    if [ -f "$env_file" ]; then
        port=$(grep -E '^CFDDNS_PORT=' "$env_file" 2>/dev/null | tail -n 1 | cut -d= -f2 | tr -d ' \r')
    fi
    case "$port" in
        ''|*[!0-9]*) port=8080 ;;
    esac
    if [ "$port" -lt 1024 ] || [ "$port" -gt 65535 ]; then
        port=8080
    fi

    local ui_conf="${TRIM_APPDEST}/ui/config"
    if [ -f "$ui_conf" ]; then
        # 这里用 [^\"]* 而不是 [0-9]+，是为了同时兜住两种「port 不是数字」的情况：
        #   ① 模板里写的是占位符 ${wizard_port}，飞牛版本低于 1.1.8 时不认识它，
        #      会原样留在文件里（匹配不到纯数字）；
        #   ② 用户在向导里把端口留空，飞牛替换成了空串。
        # 两种情况都必须能改成本次真实端口，否则点图标连的是空端口/字面量，必然打不开。
        sed -i -E "s/(\"port\"[[:space:]]*:[[:space:]]*\")[^\"]*(\")/\1${port}\2/" "$ui_conf" 2>/dev/null \
            || echo "[cf-ddns-sidecar] 警告：无法写入 $ui_conf"
    fi

    local mf="${TRIM_APPDEST}/../manifest"
    if [ -f "$mf" ]; then
        sed -i -E "s/^service_port[[:space:]]*=.*/service_port = ${port}/" "$mf" 2>/dev/null \
            || echo "[cf-ddns-sidecar] 警告：无法写入 $mf"
    fi

    echo "[cf-ddns-sidecar] 后台端口: ${port}"
}

is_docker_running() {
    local container_name=""

    if [ -f "$FILE_PATH" ]; then
        container_name=$(grep "container_name" "$FILE_PATH" | head -n 1 | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$container_name" ]; then
        docker inspect "$container_name" 2>/dev/null | grep -q '"Status": "running"' || return 1
        return 0
    fi
    return 1
}

case "$1" in
    start)
        # docker application will be started by appcenter
        init_on_start
        exit 0
        ;;
    init)
        # 供 install_init 在安装阶段提前生成配置（共享目录已就绪时）
        init_on_start
        exit 0
        ;;
    stop)
        # docker application will be stopped by appcenter
        exit 0
        ;;
    status)
        if is_docker_running; then
            exit 0
        else
            exit 3
        fi
        ;;
    *)
        exit 1
        ;;
esac
