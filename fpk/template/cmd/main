#!/bin/bash

# 飞牛生命周期脚本：处理 start / stop / status。
# 首次 start 时：解析数据共享目录真实路径 → 注入 compose → 生成 ddns.env 示例。

APP_NAME="${TRIM_APPNAME:-cf-ddns-sidecar}"
FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

fail() {
    echo "$1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
}

# 解析数据共享目录真实路径（官方环境变量，多个以 : 分隔）
resolve_share_root() {
    local root="${TRIM_DATA_SHARE_PATHS%%:*}"
    if [ -z "$root" ] || [ ! -d "$root" ]; then
        # 兜底：官方约定的软链路径
        root="/var/apps/${APP_NAME}/share/${APP_NAME}"
    fi
    echo "$root"
}

# 首次启动初始化：注入共享路径 + 生成示例配置（幂等，可重复执行）
init_on_start() {
    local share_root
    share_root="$(resolve_share_root)" || fail "无法定位数据共享目录"
    mkdir -p "${share_root}/subject" "${share_root}/sidecar" "${share_root}/conf" \
        || fail "无法创建数据目录: ${share_root}"

    # 将占位符替换为真实路径（已替换过则 sed 自然跳过）
    if [ -f "$FILE_PATH" ] && grep -q "__SHARE_ROOT__" "$FILE_PATH"; then
        sed -i "s|__SHARE_ROOT__|${share_root}|g" "$FILE_PATH" \
            || fail "compose 路径注入失败"
    fi

    # 生成 ddns.env 示例（仅当不存在时），避免 env_file 缺失导致 compose 起不来
    if [ ! -f "${share_root}/sidecar/ddns.env" ]; then
        cat > "${share_root}/sidecar/ddns.env" <<'EOF'
# ============================================================
# cf-ddns-sidecar 配置（本文件是唯一必填入口）
# 修改保存后：飞牛「应用中心 → 本应用 → 重启」使其生效
# ============================================================

# --- 必填：DDNS 服务商（四选一：cloudflare / aliyun / dnspod / huawei）---
CFDDNS_PROVIDER=cloudflare

# --- 必填：你的优选域名（A 记录将指向最优 IP）---
CFDDNS_DOMAIN=cf.example.com

# --- Cloudflare 密钥（provider=cloudflare 时必填）---
#CF_API_TOKEN=
#CF_ZONE_ID=

# --- 阿里云密钥（provider=aliyun 时必填）---
#ALIYUN_ACCESS_KEY_ID=
#ALIYUN_ACCESS_KEY_SECRET=
# 多级公共后缀（如 example.com.cn）才需要，一般留空
#ALIYUN_ROOT_DOMAIN=

# --- 腾讯云 DNSPod 密钥（provider=dnspod 时必填）---
#TENCENT_SECRET_ID=
#TENCENT_SECRET_KEY=
# 多级公共后缀才需要，一般留空
#DNSPOD_ROOT_DOMAIN=

# --- 华为云密钥（provider=huawei 时必填）---
#HUAWEI_AK=
#HUAWEI_SK=
#HUAWEI_ZONE_ID=

# --- 可选：轮询间隔（秒，默认 30）---
#CFDDNS_POLL_INTERVAL=30
EOF
        echo "[cf-ddns-sidecar] 已生成示例配置: ${share_root}/sidecar/ddns.env"
    fi
}

is_docker_running() {
    DOCKER_NAME=""

    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(cat "$FILE_PATH" | grep "container_name" | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$DOCKER_NAME" ]; then
        docker inspect "$DOCKER_NAME" 2>/dev/null | grep -q '"Status": "running"' || return 1
        return 0
    fi
    return 1
}

case "$1" in
    start)
        # docker application will be started by appcenter
        init_on_start
        exit 0
        ;;
    stop)
        # docker application will be stopped by appcenter
        exit 0
        ;;
    status)
        if is_docker_running; then
            exit 0
        else
            exit 3
        fi
        ;;
    *)
        exit 1
        ;;
esac
