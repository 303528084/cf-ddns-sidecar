#!/bin/bash
#
# 飞牛生命周期脚本：uninstall_callback（卸载完成后执行）。
#
# 【2026-11-17 重要修改】这里以前是 `rm -rf $SHARE_ROOT`，本意是
# 「卸载后别在文件管理里留个空文件夹」。这个取舍做错了：
#
#   v1.0.1 → v1.1.0 那次**升级**（不是卸载重装），用户后台里的 AdGuard
#   地址、域名、各家 DNS 密钥全部变回默认值。程序启动日志显示 ddns.env、
#   dashboard-password、.wizard-env-applied 三个文件同时不存在——数据目录
#   被整个清空了。最可能就是本脚本在升级流程里被执行了（飞牛的「升级」
#   在部分版本上走的是「卸旧装新」）。
#
# 现在的原则：**只清容器，绝不动数据。**
# 飞牛自己的约定也是「卸载默认保留用户数据」。想清空请用户自己去
# 「文件管理」里删（提示里已经写清楚了）。
#
# 代价：卸载后文件管理里会剩一个 cf-ddns-sidecar 共享文件夹。
# 这个代价远比「升个级把密钥全丢了」小得多。

APP_NAME="${TRIM_APPNAME:-cf-ddns-sidecar}"
SHARE_ROOT="/var/apps/${APP_NAME}/share/${APP_NAME}"
# 数据位置，与 cmd/main、compose 保持一致：
#   v1.5.0 起是官方 TRIM_PKGVAR（通常链到 /vol{n}/@appdata/<app>），
#   v1.4.x 是 <app>-data，v1.1.0～v1.3.2 在 share/<app>/data。
# 三个都有可能存在（升级过的机器），提示里要都能指到。
if [ -n "${TRIM_PKGVAR:-}" ]; then
    DATA_ROOT="$TRIM_PKGVAR"
else
    DATA_ROOT="/var/apps/${APP_NAME}-data"
fi

log() {
    echo "[cf-ddns-sidecar] $*"
}

# 只兜底清容器（防止 uninstall_init 未执行或执行失败）。不删任何文件。
docker rm -f -v cf-ddns-sidecar >/dev/null 2>&1 || true
docker rm -f cf-dns-select >/dev/null 2>&1 || true

# 指向存储卷时用解析后的真实路径，用户照着这个路径在文件管理器里更好找。
DATA_REAL="$(readlink -f "$DATA_ROOT" 2>/dev/null)"
if [ -n "$DATA_REAL" ] && [ -d "$DATA_REAL" ]; then
    log "已保留数据目录：${DATA_REAL}"
    log "（这是飞牛给应用自己的数据目录；文件管理里在存储空间的 @appdata 下面）"
    log "如需彻底清除（含域名、服务商密钥、后台密码），请手动删除该文件夹"
elif [ -d "/var/apps/${APP_NAME}-data" ]; then
    log "已保留数据目录：/var/apps/${APP_NAME}-data（v1.4.x 的位置）"
    log "如需彻底清除（含域名、服务商密钥、后台密码），请到「文件管理」里手动删除该文件夹"
elif [ -d "${SHARE_ROOT}/data" ]; then
    log "已保留数据目录：${SHARE_ROOT}/data（老版本位置）"
    log "如需彻底清除（含域名、服务商密钥、后台密码），请到「文件管理」里手动删除该文件夹"
fi

exit 0
